# Copy to .env for local development. Placeholders only — never commit real values.
# Production keeps these in /home/kian/apps/hamrooz/shared/app.env (mode 600).

DATABASE_URL=postgresql://hamrooz:CHANGE_ME@127.0.0.1:5432/hamrooz
APP_URL=http://localhost:3000
APP_RELEASE=dev

# 32 random bytes, base64 (encrypts Google tokens at rest):  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_ENCRYPTION_KEY=

# The only account allowed to sign in with Google
OWNER_EMAIL=owner@example.com

# Web Push (generate with: node dist/cli.mjs vapid)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:owner@example.com

# Google OAuth (Calendar + optional sign-in). Redirect URI: ${APP_URL}/api/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Speech-to-text (Persian) — server side only
OPENAI_API_KEY=
STT_MODEL=gpt-4o-transcribe

# Optional structured extraction from transcripts/text (Claude)
ANTHROPIC_API_KEY=
EXTRACT_MODEL=claude-opus-5-5

# Tests (local only)
TEST_DATABASE_URL=postgresql://hamrooz:CHANGE_ME@127.0.0.1:5432/hamrooz_test
DEV_OWNER_EMAIL=dev@hamrooz.test
DEV_OWNER_PASSWORD=
